# Copy this to `.env` and fill in real values before running
# `docker compose up`. A ready-to-use `.env` for local testing already
# exists in this repo (git-ignored in real deployments — see README).

# --- Container registry (docker-compose.deploy.yml only) ---
# docker-compose.deploy.yml needs REGISTRY (the container registry host). CI
# injects it from the REGISTRY_HOST Actions variable; it is deliberately NOT
# kept here. For a manual `docker compose pull` / rollback on the host, pass it
# on the command line, e.g.  REGISTRY=<host> IMAGE_TAG=<sha> docker compose pull
# (see docs/deployment.md).

# --- Database ---
POSTGRES_USER=postgres
# REQUIRED — the stack refuses to start if this is unset. Generate a strong
# value, e.g. `openssl rand -base64 36`. Do not deploy this placeholder.
POSTGRES_PASSWORD=
POSTGRES_DB=flockademic_prod
# Postgres is NOT published to the host by default (see docker-compose.yml) —
# the app reaches it over the compose network. This var is only used if you
# uncomment the loopback-only port mapping there for local debugging.
POSTGRES_PORT=5432
# Host directory Postgres' data files are bind-mounted into — kept
# outside the image/container so it survives rebuilds and is backupable.
POSTGRES_DATA_DIR=./data/postgres

# --- Phoenix app ---
# REQUIRED — the stack refuses to start if this is unset. Generate with
# `mix phx.gen.secret` or `openssl rand -base64 48`. Do not deploy a placeholder.
SECRET_KEY_BASE=
POOL_SIZE=10

# --- Basemap tiles ---
# CARTO requires a free API key for basemap tiles; without it the map
# renders with an "API KEY REQUIRED" watermark. Get one at
# https://carto.com/basemaps/apikey/ (free tier: 5M tile requests/month).
# Sent to the browser with every tile request, so it's not a secret.
CARTO_API_KEY=

# --- Reverse proxy / HTTPS (Caddy) ---
# A real, publicly-resolvable hostname gets a real auto-renewing Let's
# Encrypt certificate (ports 80/443 must be reachable from the internet
# for the ACME challenge). Use "localhost" for local testing — Caddy will
# issue a locally-trusted cert from its own internal CA instead.
DOMAIN=your-domain.example.com
ACME_EMAIL=you@example.com

# --- Camera data ingestion ---
# Host directory bind-mounted read-only into the app container at
# /data/cameras. Drop GeoJSON extracts here (see README's "Ingesting
# camera data") and run, e.g.:
#   docker compose exec app bin/flockademic rpc \
#     'Flockademic.Release.ingest("/data/cameras/alpr.geojson")'
CAMERA_DATA_DIR=./data/cameras

# --- Scheduled re-ingestion (off by default — hits the shared public
# Overpass API on a timer once enabled; see Flockademic.Ingest.Scheduler) ---
SCHEDULED_INGEST_ENABLED=false
SCHEDULED_INGEST_INTERVAL_MS=86400000
